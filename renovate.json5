{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'docker:enableMajor',
    ':separateMultipleMajorReleases',
  ],
  baseBranchPatterns: [
    'main',
  ],
  labels: [
    'renovate',
    'dependencies',
  ],
  packageRules: [
    {
      matchUpdateTypes: [
        'patch',
      ],
      groupName: 'patch updates',
      automerge: true,
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      automerge: true,
    },
    {
      matchUpdateTypes: [
        'major',
      ],
      automerge: false,
      labels: [
        'renovate',
        'major',
      ],
    },
    {
      matchDatasources: [
        'helm',
      ],
      automerge: false,
      labels: [
        'renovate',
        'helm',
      ],
    },
    {
      matchPackageNames: [
        'viaduct-ai/kustomize-sops',
      ],
      automerge: false,
      labels: [
        'renovate',
        'bootstrap',
        'manual-apply',
      ],
      prBodyNotes: [
        '> :warning: **Manual steps required.** This bump changes only `KSOPS_VERSION`; the pinned `KSOPS_SHA256` in `bootstrap/argocd/repo-server-ksops-patch.yaml` still matches the OLD version, so the `ksops-checksum` CI job on this PR fails until you update it.',
        '',
        '1. Get the new hash and update the patch file:',
        '',
        '```bash',
        'V=<new version>',
        'curl -fsSL "https://github.com/viaduct-ai/kustomize-sops/releases/download/v${V}/checksums.txt" | grep "ksops_${V}_Linux_x86_64.tar.gz"',
        '# put that hash into KSOPS_SHA256, push to this branch, CI goes green',
        '```',
        '',
        '2. After merging (bootstrap is not ArgoCD-managed):',
        '',
        '```bash',
        'kubectl --context yornik-sharkshere apply --server-side --force-conflicts -k bootstrap/argocd/',
        'kubectl --context yornik-sharkshere -n argocd rollout status deploy/argocd-repo-server',
        '```',
      ],
    },
    {
      matchPackageNames: [
        'quay.io/argoproj/argocd',
      ],
      // Track ArgoCD with semver, not the default docker versioning. Docker
      // versioning treats the `-rc7` in `v3.4.0-rc7` as a compatibility suffix
      // and rejects every suffix-less stable tag (v3.4.0 .. v3.4.3), so no
      // upgrade PR is ever opened. With semver, rc7 is a prerelease of 3.4.0
      // and — because the current version is itself a prerelease — Renovate
      // rolls forward to the latest stable release.
      versioning: 'semver',
      automerge: false,
      labels: [
        'renovate',
        'bootstrap',
        'manual-apply',
      ],
      prBodyNotes: [
        '> :warning: **Manual apply required.** ArgoCD does not manage its own bootstrap manifest, so this PR cannot be auto-applied by the cluster.',
        '',
        'After merging, run:',
        '',
        '```bash',
        'kubectl --context yornik-sharkshere apply --server-side --force-conflicts \\',
        '  -k bootstrap/argocd/',
        '```',
        '',
        '`--server-side` is required because ArgoCD\'s `applicationsets.argoproj.io` CRD has an OpenAPI schema larger than the 256 KiB annotation limit used by client-side `kubectl apply`. `--force-conflicts` lets server-side apply take ownership of fields previously managed by older client-side applies.',
        '',
        'Then verify the rollout and that all Applications stay healthy:',
        '',
        '```bash',
        'kubectl --context yornik-sharkshere -n argocd rollout status \\',
        '  deploy/argocd-server deploy/argocd-repo-server \\',
        '  statefulset/argocd-application-controller',
        'kubectl --context yornik-sharkshere -n argocd get applications',
        '```',
        '',
        'Rollback (if needed): revert the commit on `main`, run the same `kubectl apply --server-side --force-conflicts -k bootstrap/argocd/` again to restore the previous version.',
      ],
    },
  ],
  kubernetes: {
    managerFilePatterns: [
      '/manifests/.+\\.yaml$/',
      '/bootstrap/argocd/install\\.yaml$/',
      // Picks up the alpine init-container image in the ksops repo-server
      // patch. The KSOPS_VERSION inside its script has its own regex
      // manager below.
      '/bootstrap/argocd/repo-server-ksops-patch\\.yaml$/',
    ],
  },
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/apps/values\\.yaml$/',
      ],
      matchStrings: [
        'repoURL:\\s*(?<registryUrl>\\S+)\\s*\\n\\s*chart:\\s*(?<depName>\\S+)\\s*\\n\\s*targetRevision:\\s*[\'"]?(?<currentValue>[^\'"\\s]+)[\'"]?',
      ],
      datasourceTemplate: 'helm',
    },
    // Track the ksops version in the repo-server init container. Renovate
    // bumps KSOPS_VERSION only — it cannot compute the release tarball's
    // sha256, so KSOPS_SHA256 must be updated by hand (see prBodyNotes on
    // the viaduct-ai/kustomize-sops packageRule). The `ksops-checksum` CI
    // job fails until version and hash agree, so a bump PR cannot merge
    // with a stale hash.
    {
      customType: 'regex',
      managerFilePatterns: [
        '/bootstrap/argocd/repo-server-ksops-patch\\.yaml$/',
      ],
      matchStrings: [
        'KSOPS_VERSION=(?<currentValue>[0-9][0-9.]*)',
      ],
      depNameTemplate: 'viaduct-ai/kustomize-sops',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v(?<version>.+)$',
    },
    // Track tool versions pinned in workflow env vars via the standard
    // `# renovate: datasource=... depName=...` comment convention
    // (e.g. KUBECONFORM_VERSION in validate.yaml).
    {
      customType: 'regex',
      managerFilePatterns: [
        '/\\.github/workflows/.+\\.ya?ml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\n\\s*[A-Z_]+_VERSION: (?<currentValue>\\S+)',
      ],
    },
    // Track the default job image inside the gitlab-runner runners.config
    // TOML string (`image = "alpine:X.Y"`). The `image = "..."` TOML
    // assignment appears exactly once in apps/values.yaml; Helm-values
    // images use `image:` (colon) syntax and are not matched.
    {
      customType: 'regex',
      managerFilePatterns: [
        '/apps/values\\.yaml$/',
      ],
      matchStrings: [
        'image = "(?<depName>[a-z0-9./-]+):(?<currentValue>[A-Za-z0-9._-]+)"',
      ],
      datasourceTemplate: 'docker',
    },
    // Track the Traefik fail2ban plugin pin. Anchored to the moduleName
    // line directly above so it cannot match any other `version:` key.
    {
      customType: 'regex',
      managerFilePatterns: [
        '/apps/values\\.yaml$/',
      ],
      matchStrings: [
        'moduleName: github\\.com/tomMoulard/fail2ban\\s*\\n\\s*version: (?<currentValue>v[0-9.]+)',
      ],
      depNameTemplate: 'tomMoulard/fail2ban',
      datasourceTemplate: 'github-releases',
    },
    // Track SHA-pinned raw.githubusercontent.com URLs (e.g. the upstream
    // CNPG Grafana dashboard JSON we import at Grafana pod startup).
    // Renovate proposes PRs when the tracked branch advances.
    {
      customType: 'regex',
      managerFilePatterns: [
        '/apps/values\\.yaml$/',
      ],
      matchStrings: [
        'https://raw\\.githubusercontent\\.com/(?<depName>[^/]+/[^/]+)/(?<currentDigest>[a-f0-9]{40})/',
      ],
      currentValueTemplate: 'main',
      datasourceTemplate: 'git-refs',
      packageNameTemplate: 'https://github.com/{{depName}}',
    },
  ],
}
