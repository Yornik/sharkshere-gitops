{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'docker:enableMajor',
    ':separateMultipleMajorReleases',
  ],
  baseBranchPatterns: [
    'main',
  ],
  labels: [
    'renovate',
    'dependencies',
  ],
  packageRules: [
    // The Claude review job reads the `automerge` label. It decides from the
    // label whether a bump needs a person. Only these 2 rules set automerge.
    // Only these 2 carry the label. Every other bump waits for a person, and
    // the job reviews it. Examples are a minor bump from github-releases
    // (tomMoulard/fail2ban), a new commit from git-refs (the CNPG dashboard)
    // and a minor bump from the github-actions manager. Keep the label and
    // `automerge` together.
    {
      matchUpdateTypes: [
        'patch',
      ],
      groupName: 'patch updates',
      automerge: true,
      labels: [
        'renovate',
        'dependencies',
        'automerge',
      ],
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      automerge: true,
      labels: [
        'renovate',
        'dependencies',
        'automerge',
      ],
    },
    {
      matchUpdateTypes: [
        'major',
      ],
      automerge: false,
      labels: [
        'renovate',
        'major',
      ],
    },
    {
      matchDatasources: [
        'helm',
      ],
      automerge: false,
      labels: [
        'renovate',
        'helm',
      ],
    },
    {
      matchPackageNames: [
        'viaduct-ai/kustomize-sops',
      ],
      automerge: false,
      labels: [
        'renovate',
        'bootstrap',
        'manual-apply',
      ],
      prBodyNotes: [
        '> :warning: **Manual steps required.** This bump changes only `KSOPS_VERSION`; the pinned `KSOPS_SHA256` in `bootstrap/argocd/repo-server-ksops-patch.yaml` still matches the OLD version, so the `ksops-checksum` CI job on this PR fails until you update it.',
        '',
        '1. Get the new hash and update the patch file:',
        '',
        '```bash',
        'V=<new version>',
        'curl -fsSL "https://github.com/viaduct-ai/kustomize-sops/releases/download/v${V}/checksums.txt" | grep "ksops_${V}_Linux_x86_64.tar.gz"',
        '# put that hash into KSOPS_SHA256, push to this branch, CI goes green',
        '```',
        '',
        '2. After merging (bootstrap is not ArgoCD-managed):',
        '',
        '```bash',
        'kubectl --context yornik-sharkshere apply --server-side --force-conflicts -k bootstrap/argocd/',
        'kubectl --context yornik-sharkshere -n argocd rollout status deploy/argocd-repo-server',
        '```',
      ],
    },
    {
      matchPackageNames: [
        'quay.io/argoproj/argocd',
      ],
      // Track ArgoCD with semver, not the default docker versioning. Docker
      // versioning treats the `-rc7` in `v3.4.0-rc7` as a compatibility suffix
      // and rejects every suffix-less stable tag (v3.4.0 .. v3.4.3), so no
      // upgrade PR is ever opened. With semver, rc7 is a prerelease of 3.4.0
      // and — because the current version is itself a prerelease — Renovate
      // rolls forward to the latest stable release.
      versioning: 'semver',
      automerge: false,
      labels: [
        'renovate',
        'bootstrap',
        'manual-apply',
      ],
      prBodyNotes: [
        '> :warning: **Manual apply required.** ArgoCD does not manage its own bootstrap manifest, so this PR cannot be auto-applied by the cluster.',
        '',
        'After merging, run:',
        '',
        '```bash',
        'kubectl --context yornik-sharkshere apply --server-side --force-conflicts \\',
        '  -k bootstrap/argocd/',
        '```',
        '',
        '`--server-side` is required because ArgoCD\'s `applicationsets.argoproj.io` CRD has an OpenAPI schema larger than the 256 KiB annotation limit used by client-side `kubectl apply`. `--force-conflicts` lets server-side apply take ownership of fields previously managed by older client-side applies.',
        '',
        'Then verify the rollout and that all Applications stay healthy:',
        '',
        '```bash',
        'kubectl --context yornik-sharkshere -n argocd rollout status \\',
        '  deploy/argocd-server deploy/argocd-repo-server \\',
        '  statefulset/argocd-application-controller',
        'kubectl --context yornik-sharkshere -n argocd get applications',
        '```',
        '',
        'Rollback (if needed): revert the commit on `main`, run the same `kubectl apply --server-side --force-conflicts -k bootstrap/argocd/` again to restore the previous version.',
      ],
    },
    {
      matchPackageNames: [
        'jellyfin/jellyfin',
      ],
      // Jellyfin dropped the leading "10." from its version scheme: what
      // would have been 10.12.0 is tagged `12.0` on Docker Hub (two
      // segments), and 10.11.x was the last branch with three-segment
      // tags. The default docker versioning only treats tags with the same
      // number of segments as the current pin as compatible, so `12.0` is
      // silently rejected against `10.11.11` and no upgrade PR is ever
      // opened. This regex accepts `MAJOR.MINOR` and `MAJOR.MINOR.PATCH`
      // alike, treats `-rcN` as a prerelease (ignored while pinned to a
      // stable), and rejects the `latest`/`unstable`/`preview`, the
      // date-stamped nightlies (`2026090709`) and the per-arch build tags
      // (`12.0-amd64.20260908-012347`), which never match the anchored
      // pattern.
      versioning: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)(\\.(?<patch>\\d+))?(-(?<prerelease>rc\\d+))?$',
    },
    {
      matchPackageNames: [
        'lscr.io/linuxserver/qbittorrent',
      ],
      // LinuxServer puts a build counter in the tag. The default docker
      // versioning reads the text after the first hyphen as a compatibility
      // suffix and keeps it. So the pin `5.1.4-r2-ls440` asked for the suffix
      // `r2-ls440`. No later tag carries it, so Renovate opened no bump. It
      // also rejected the rebuilds `ls441` to `ls446`.
      //
      // Measured on 2026-10-21. The tag replaced `latest` on 2026-08-31. The
      // build it names is from 2026-02-08, so it was 6 months old already. It
      // did not move again, and 5.2.0 to 5.3.0 shipped.
      //
      // LinuxServer changed the scheme at 5.2.0. `-r<N>-ls<build>` became
      // `_v<libtorrent>-ls<build>`. The old tag matches no new pattern, so a
      // rule alone cannot help. The pin moved by hand in the same commit.
      //
      // This regex reads the qBittorrent version. It treats the LinuxServer
      // counter as the build, so a rebuild arrives as a bump.
      //
      // The pattern is anchored. It takes the plain release tags only, and
      // rejects `latest`, `libtorrentv1`, the `version-` tags and the per-arch
      // tags. It rejects the `-libtorrentv1` line as well. That line is
      // another libtorrent major, and a move to it rewrites the resume data.
      versioning: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)_v[\\d.]+-ls(?<build>\\d+)$',
    },
    {
      matchPackageNames: [
        'lscr.io/linuxserver/qbittorrent',
      ],
      // A major update keeps the `major` label from the rule above, so this
      // rule takes a patch and a minor only.
      matchUpdateTypes: [
        'patch',
        'minor',
      ],
      // The libtorrent version in the tag is not a capture group, because a
      // group holds digits only. It changes inside a bump that the regex
      // reads as a build bump. On 2026-10-20 qBittorrent 5.3.0 moved from
      // `_v2.0.15-ls482` to `_v2.1.2-ls484`. libtorrent went from 2.0.15 to
      // 2.1.2, and qBittorrent did not move.
      //
      // libtorrent writes the resume data, so check A5 applies. A person
      // reads the diff.
      automerge: false,
      // Rule 1 groups every patch update. A grouped pull request takes the
      // labels of each bump in it. A sibling then brings the `automerge`
      // label, and the gate in claude-review.yml skips the review. `null`
      // keeps this package out of every group.
      groupName: null,
      // NOTE: a later rule replaces `labels`, it does not merge them. The
      // `automerge` label decides whether the review runs, so the inherited
      // label would skip the review of a pull request that does not
      // automerge.
      labels: [
        'renovate',
        'dependencies',
      ],
    },
  ],
  kubernetes: {
    managerFilePatterns: [
      '/manifests/.+\\.yaml$/',
      '/bootstrap/argocd/install\\.yaml$/',
      // Picks up the alpine init-container image in the ksops repo-server
      // patch. The KSOPS_VERSION inside its script has its own regex
      // manager below.
      '/bootstrap/argocd/repo-server-ksops-patch\\.yaml$/',
    ],
  },
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/apps/values\\.yaml$/',
      ],
      matchStrings: [
        'repoURL:\\s*(?<registryUrl>\\S+)\\s*\\n\\s*chart:\\s*(?<depName>\\S+)\\s*\\n\\s*targetRevision:\\s*[\'"]?(?<currentValue>[^\'"\\s]+)[\'"]?',
      ],
      datasourceTemplate: 'helm',
    },
    // Track the ksops version in the repo-server init container. Renovate
    // bumps KSOPS_VERSION only — it cannot compute the release tarball's
    // sha256, so KSOPS_SHA256 must be updated by hand (see prBodyNotes on
    // the viaduct-ai/kustomize-sops packageRule). The `ksops-checksum` CI
    // job fails until version and hash agree, so a bump PR cannot merge
    // with a stale hash.
    {
      customType: 'regex',
      managerFilePatterns: [
        '/bootstrap/argocd/repo-server-ksops-patch\\.yaml$/',
      ],
      matchStrings: [
        'KSOPS_VERSION=(?<currentValue>[0-9][0-9.]*)',
      ],
      depNameTemplate: 'viaduct-ai/kustomize-sops',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v(?<version>.+)$',
    },
    // Track tool versions pinned in workflow env vars via the standard
    // `# renovate: datasource=... depName=...` comment convention
    // (e.g. KUBECONFORM_VERSION in validate.yaml).
    {
      customType: 'regex',
      managerFilePatterns: [
        '/\\.github/workflows/.+\\.ya?ml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\n\\s*[A-Z_]+_VERSION: (?<currentValue>\\S+)',
      ],
    },
    // Track the default job image inside the gitlab-runner runners.config
    // TOML string (`image = "alpine:X.Y"`). The `image = "..."` TOML
    // assignment appears exactly once in apps/values.yaml; Helm-values
    // images use `image:` (colon) syntax and are not matched.
    {
      customType: 'regex',
      managerFilePatterns: [
        '/apps/values\\.yaml$/',
      ],
      matchStrings: [
        'image = "(?<depName>[a-z0-9./-]+):(?<currentValue>[A-Za-z0-9._-]+)"',
      ],
      datasourceTemplate: 'docker',
    },
    // Track the Traefik fail2ban plugin pin. Anchored to the moduleName
    // line directly above so it cannot match any other `version:` key.
    {
      customType: 'regex',
      managerFilePatterns: [
        '/apps/values\\.yaml$/',
      ],
      matchStrings: [
        'moduleName: github\\.com/tomMoulard/fail2ban\\s*\\n\\s*version: (?<currentValue>v[0-9.]+)',
      ],
      depNameTemplate: 'tomMoulard/fail2ban',
      datasourceTemplate: 'github-releases',
    },
    // Track SHA-pinned raw.githubusercontent.com URLs (e.g. the upstream
    // CNPG Grafana dashboard JSON we import at Grafana pod startup).
    // Renovate proposes PRs when the tracked branch advances.
    {
      customType: 'regex',
      managerFilePatterns: [
        '/apps/values\\.yaml$/',
      ],
      matchStrings: [
        'https://raw\\.githubusercontent\\.com/(?<depName>[^/]+/[^/]+)/(?<currentDigest>[a-f0-9]{40})/',
      ],
      currentValueTemplate: 'main',
      datasourceTemplate: 'git-refs',
      packageNameTemplate: 'https://github.com/{{depName}}',
    },
  ],
}
